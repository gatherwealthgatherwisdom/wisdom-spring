{
  "expo": {
    "name": "智泉",
    "slug": "wisdom-spring",
    "scheme": "spring",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gwgwgroup.spring",
      "infoPlist": {
        "NSCameraUsageDescription": "智泉用相機影相，方便你問圖。",
        "NSPhotoLibraryUsageDescription": "智泉讀相簿相片，方便你問圖。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.gwgwgroup.spring"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "智泉讀相簿相片，方便你問圖。",
          "cameraPermission": "智泉用相機影相，方便你問圖。"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
